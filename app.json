{
  "expo": {
    "name": "HGB Savings Planner",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Logo/hgb.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/Logo/hgb.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/Logo/hgb.png"
      },
      "package": "com.hgb.customer",
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/Logo/hgb.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/Logo/hgb.png",
          "backgroundColor": "#FFFFFF",
          "imageWidth": 200
        }
      ],
      "expo-notifications",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      ["expo-build-properties", { "android": { "usesCleartextTraffic": true } }]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "d0a46c44-a184-4e07-8d99-19a310a1e969"
      }
    },
    "owner": "hyzshirass-team"
  }
}
